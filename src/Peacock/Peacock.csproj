<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Peacock</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net46</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="HitmanPatcher.Novikov_error.png" />
    <None Remove="HitmanPatcher.Novikov_standard.png" />
    <None Remove="HitmanPatcher.Novikov_success.png" />
    <None Remove="HitmanPatcher.patcher.ico" />
    <None Remove="ILRepack.List" />
    <EmbeddedResource Include="HitmanPatcher.Novikov_error.png" LogicalName="HitmanPatcher.Novikov_error.png" />
    <EmbeddedResource Include="HitmanPatcher.Novikov_standard.png" LogicalName="HitmanPatcher.Novikov_standard.png" />
    <EmbeddedResource Include="HitmanPatcher.Novikov_success.png" LogicalName="HitmanPatcher.Novikov_success.png" />
    <EmbeddedResource Include="HitmanPatcher.patcher.ico" LogicalName="HitmanPatcher.patcher.ico" />
    <EmbeddedResource Include="ILRepack.List" LogicalName="ILRepack.List" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Core" />
    <None Remove="Server\Embedded\Peacock.Server.bytes" />
    <EmbeddedResource Include="Server\Embedded\Peacock.Server.bytes" LogicalName="Peacock.Server.bytes" />
  </ItemGroup>
  <Target Name="CompileEmbeddedServer" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.." Command="npm.cmd ci --prefix tools" Condition="!Exists('$(MSBuildProjectDirectory)\..\..\tools\node_modules\postject')" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.." Command="node tools/compile-server.cjs" />
  </Target>
  <ItemGroup>
    <None Update="Server\**\*;WebUI\**\*" />
    <None Include="..\..\data\**\*.json" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\config\options.ini" Link="Configuration\options.ini" />
  </ItemGroup>
  <Target Name="PackageApplication" AfterTargets="Build" Condition="'$(SkipPackaging)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.." Command="npm.cmd ci --prefix tools" Condition="!Exists('$(MSBuildProjectDirectory)\..\..\tools\node_modules\msgpackr')" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.." Command="node tools/assemble.cjs $(Configuration)" />
  </Target>
</Project>
